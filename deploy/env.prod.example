# Copy to /home/lain4504/aitoearn/.env.prod on the VPS (never commit real secrets).

DOCKER_IMAGE_PREFIX=lain4504
IMAGE_TAG=latest

# Shared Mirai RustFS (host nginx -> 127.0.0.1:19000, DNS rustfs.local on tako-network)
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# Public app URL (OAuth redirect URIs, asset CDN)
APP_DOMAIN=yt.mirailabs.space

# Optional — override config.yaml defaults via compose if needed later
# JWT_SECRET=
# MONGODB_URI=
